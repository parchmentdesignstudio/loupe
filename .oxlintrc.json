{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": [
		"typescript",
		"react",
		"jsx-a11y",
		"import",
		"unicorn",
		"oxc"
	],
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"rules": {
		"react/react-in-jsx-scope": "off"
	},
	"ignorePatterns": [
		"**/lib/**",
		"**/node_modules/**",
		"packages/icons/**"
	]
}
