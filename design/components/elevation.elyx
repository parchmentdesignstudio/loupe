import "tokens/colors.elyx" as base
import "tokens/lengths.elyx" as l

// Parchment’s elevation: a frame per shadow, with the fill and corners it goes with. Instance one and give it a size
// and contents. Each shadow is a soft drop and a 1px edge, in colours from colors.elyx, so it follows the theme.
// Written from packages/ui/tokens.css by pnpm elyx:tokens, so edit the CSS rather than this file.
file {}

export raised = frame {
  caption: "Chips, fields and checkboxes",
  left: 0px,
  top: 0px,
  width: 160px,
  height: 96px,
  fill: base.colors.raised,
  shadow: [
    {
      drop-shadow: {
        color: base.colors.drop-raised,
        offset: point(0px, 2px),
        blur-radius: 4px,
        spread: -2px
      }
    },
    {
      drop-shadow: {
        color: base.colors.drop-raised,
        offset: point(0px, 1px),
        blur-radius: 3px,
        spread: -1.5px
      }
    },
    {
      drop-shadow: {
        color: base.colors.drop-raised,
        offset: point(0px, 1px),
        blur-radius: 1px,
        spread: -1px
      }
    },
    {drop-shadow: {color: base.colors.edge, spread: 0.5px}},
    {drop-shadow: {color: base.colors.sheen}},
    {drop-shadow: {color: base.colors.toplight, blur-radius: 0.5px}}
  ],
  corner-radius: l.lengths.radius-lg,
  slot: .true
}

