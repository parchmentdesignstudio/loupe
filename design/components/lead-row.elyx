import "tokens/colors.elyx" as c
import "tokens/lengths.elyx" as l
import "components/status.elyx" as statuses
import "components/text.elyx" as styles

// A lead in a list, as the Leads screen has one: the client in Medium over the developer and site, and where the lead is
// up to at the end. A hairline along the top parts it from what's above, in a raised card's tint. Instance one, set the
// client and site, and pick the status's variant with @with-variant
file {}

export leadRow = frame {
  caption: "A buyer a developer has just referred",
  left: 0px,
  top: 0px,
  width: 400px,
  layout: {
    justify-content: .space-between,
    align-items: .center,
    item-gap: l.lengths.spacing-4
  },
  border: {color: c.tints.raised-8, sides: .top},
  padding: [l.lengths.spacing-2-5, l.lengths.spacing-4],
  children: [lead, leadStatus],

  lead = frame {
    layout: {direction: .column},
    children: [client, site],

    client = text : styles.control {
      contents: "Ada Lovelace",
      font-style: "Medium"
    }

    site = text : styles.label {
      contents: "Barratt Homes, Oakwood Gardens",
      fill[0].color: c.colors.muted
    }
  }

  leadStatus = frame : statuses.info {}
}
