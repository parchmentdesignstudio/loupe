import "./colors.elyx" as base

// The dark values of colors.elyx. Every role is here, even one that only names another, as a role colors.elyx
// gives keeps its light value in the dark. Written from packages/ui/styles/theme.css by pnpm elyx:tokens, so edit the CSS rather than this file.
@context(theme="dark")
file {}

export dark-colors = tokens : base.colors {
  // The roles components use, each light-dark(light, dark). The dark mode inverts the light one: the ground
  // takes ink's pine, and ink takes the ground's cream
  ink: base.colors.cream-95,
  muted: base.colors.linen-90,
  danger: base.colors.red-81,
  // Marks on ink, such as a button's text or a checkbox's tick
  paper: base.colors.pine-20,
  // What a page leads with, and what marks the current page or today: marigold, as a primary button is, in both themes
  accent: base.colors.marigold-83,
  // The light accent, a fill behind ink to mark something out. In the dark it's an olive tint over what it sits on
  highlight: opacity(base.colors.olive-91, 24%),
  // A primary button's fill, marigold, and a quiet button's, slate, each with the ink on it. Both themes share them,
  // as the fills stay light
  primary: base.colors.marigold-83,
  on-primary: base.colors.pine-26,
  quiet: base.colors.slate-86,
  on-quiet: base.colors.pine-26,
  // The layers, from the page up. In the light, the ground and panel are off-white linen, raised and
  // overlay are white, and shadows part them. In the dark, each is lighter than the one below, starting near black
  // so there's room above the controls for hover and what's chosen
  ground: base.colors.pine-16,
  // An area on the page, such as a tool's side panel
  panel: base.colors.pine-20,
  // A control's fill, such as a button's, a field's or a checkbox's
  raised: base.colors.pine-24,
  // What raised turns on hover. In the light, a see-through dark linen, so it suits the ground or a panel under it
  // rather than one of them. In the dark, a step lighter than raised, as each layer there is lighter than the last
  surface: base.colors.pine-29,
  // Popovers, menus, dialogs, drawers and floating toolbars. In the dark it's a control's fill, and its edges and shadow lift it
  overlay: base.colors.pine-24,
  // Ink as a surface, such as a toast or a tooltip, with paper text
  inverse: ink,
  // A switch's handle and a slider's thumb: white in both themes, so it's the brightest thing on its track
  knob: base.colors.white,
  // What marks the one chosen in a segmented control, white in the light, and in the dark a step lighter than raised,
  // so it stands off the well it sits in
  chosen: base.colors.pine-29,
  // A pink tint that marks each chosen where several can be, and the text on it, a darker pink in the light so it reads on white
  chosen-tint: opacity(base.colors.pink-70, 18%),
  on-chosen-tint: base.colors.pink-70,
  // Behind a drawer
  scrim: opacity(base.colors.black, 48%),
  // Code, by what each part of it is rather than its grammar, so Loupe's Shiki theme (lib/shiki.js) only names these,
  // and a site restyles its code by setting them, or with data-code-theme, below. Comments and line numbers share one
  code-text: ink,
  code-comment: muted,
  // Keywords, and storage such as const and function
  code-keyword: base.colors.violet-82,
  code-string: base.colors.green-89,
  // A string's quotes
  code-quote: base.colors.green-89,
  // Booleans, hex colours and the other constants
  code-constant: base.colors.orange-89,
  // Numbers and their units
  code-number: base.colors.orange-89,
  // Functions, and the names given values: properties and custom properties
  code-function: base.colors.blue-82,
  // Types, classes and at-rules
  code-type: base.colors.yellow-91,
  // CSS's own functions, such as calc() and light-dark()
  code-builtin: base.colors.teal-88,
  // JSX and HTML tags, and their attributes
  code-tag: base.colors.pink-87,
  code-attribute: base.colors.blue-82,
  code-mark-edge: base.colors.yellow-91,
  code-add-edge: base.colors.green-89,
  code-remove-edge: base.colors.red-81,
  // Tints and lines mix from bleed at 4, 8, 12, 16, 24 or 32%, such as bg-bleed/8 for a line. See-through
  // ink would grey the linen ground, so on the ground it's ink in the ground's hue. Every layer sets its own,
  // as in bg-overlay [--bleed:var(--overlay-bleed)], so a tint suits what it sits on
  ground-bleed: base.colors.pine-95,
  panel-bleed: base.colors.pine-95,
  raised-bleed: base.colors.pine-95,
  overlay-bleed: base.colors.pine-95,
  inverse-bleed: base.colors.umber-30,
  bleed: ground-bleed,
  // Shadows have their own colours, so they stay dark in the dark. In the light, the edge is the ground's line
  // colour, and the shadows take the ground's hue, as the tints do. In the dark, the edge is a shade darker than
  // what's behind it, so it's crisp without being bright. A component that sets its own edge takes --dark-edge for
  // the dark
  dark-edge: opacity(base.colors.black, 32%),
  edge: dark-edge,
  // In the dark, a faint light line just inside the edge, and on controls a little more along the top, as if lit
  // from above. They're shadows, so they go when something is disabled or pressed flat
  sheen: opacity(bleed, 5%),
  toplight: opacity(bleed, 6%),
  // Light under the top edge and shade along the bottom, as on a rounded, glossy surface. White and black, so on a
  // coloured fill, such as a primary button, the light is a lighter tint of it
  glow: opacity(base.colors.white, 6%),
  shade: opacity(base.colors.black, 16%),
  shadow-raised-color: opacity(base.colors.black, 24%),
  shadow-floating-color: opacity(base.colors.black, 32%),
  // Only in the dark, a wide soft shade under an overlay, as fills there are too close together to part it
  shadow-deep-color: opacity(base.colors.black, 32%),
  shadow-overlay-color: opacity(base.colors.black, 48%),
  shadow-handle-color: opacity(base.colors.black, 40%),
  shadow-well-color: opacity(base.colors.black, 0%)
}

export dark-tints = tokens : base.tints {
  ground-4: opacity(dark-colors.ground-bleed, 4%),
  ground-8: opacity(dark-colors.ground-bleed, 8%),
  ground-12: opacity(dark-colors.ground-bleed, 12%),
  ground-16: opacity(dark-colors.ground-bleed, 16%),
  ground-24: opacity(dark-colors.ground-bleed, 24%),
  ground-32: opacity(dark-colors.ground-bleed, 32%),
  panel-4: opacity(dark-colors.panel-bleed, 4%),
  panel-8: opacity(dark-colors.panel-bleed, 8%),
  panel-12: opacity(dark-colors.panel-bleed, 12%),
  panel-16: opacity(dark-colors.panel-bleed, 16%),
  panel-24: opacity(dark-colors.panel-bleed, 24%),
  panel-32: opacity(dark-colors.panel-bleed, 32%),
  raised-4: opacity(dark-colors.raised-bleed, 4%),
  raised-8: opacity(dark-colors.raised-bleed, 8%),
  raised-12: opacity(dark-colors.raised-bleed, 12%),
  raised-16: opacity(dark-colors.raised-bleed, 16%),
  raised-24: opacity(dark-colors.raised-bleed, 24%),
  raised-32: opacity(dark-colors.raised-bleed, 32%),
  overlay-4: opacity(dark-colors.overlay-bleed, 4%),
  overlay-8: opacity(dark-colors.overlay-bleed, 8%),
  overlay-12: opacity(dark-colors.overlay-bleed, 12%),
  overlay-16: opacity(dark-colors.overlay-bleed, 16%),
  overlay-24: opacity(dark-colors.overlay-bleed, 24%),
  overlay-32: opacity(dark-colors.overlay-bleed, 32%),
  inverse-4: opacity(dark-colors.inverse-bleed, 4%),
  inverse-8: opacity(dark-colors.inverse-bleed, 8%),
  inverse-12: opacity(dark-colors.inverse-bleed, 12%),
  inverse-16: opacity(dark-colors.inverse-bleed, 16%),
  inverse-24: opacity(dark-colors.inverse-bleed, 24%),
  inverse-32: opacity(dark-colors.inverse-bleed, 32%)
}
