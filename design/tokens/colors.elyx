import "./colors-dark.elyx" as dark

// Parchment’s colours: the palette, and the roles components use. colors-dark.elyx holds the roles’ dark values.
// Written from packages/ui/tokens.css by pnpm elyx:tokens, so edit the CSS rather than this file.
file {}

@variants(dark.dark-colors)
export colors = tokens {
  // The palette: the raw colours, named by hue and lightness, so pine-26 is oklch(0.26 …). The further apart
  // two numbers, the stronger the contrast. Components use the roles below rather than these. First Parchment's
  // own, cream-99, blush-95, pine-26, rust-60 and lime-91, with the colours the roles work out from them
  white: .white,
  black: .black,
  cream-99: #fffdf8,
  cream-95: #f3eee6,
  cream-80: #c3bdb4,
  umber-30: #3d2a08,
  blush-95: #f5ebe6,
  rust-60: #c76024,
  lime-91: #ceeea7,
  pine-95: #ccfbe9,
  pine-50: #566861,
  pine-35: #254137,
  pine-32: #1f3930,
  pine-29: #183129,
  pine-26: #0c2920,
  pine-20: #081a14,
  red-81: #ffa699,
  red-50: #b3261e,
  // Nine hues, each light, mid and dark, for designs to draw on. No role uses them yet
  red-87: #f9c7c8,
  red-67: #f75860,
  red-35: #720006,
  orange-89: #f9d2c7,
  orange-72: #f77a58,
  orange-41: #852106,
  yellow-91: #fedf95,
  yellow-76: #e7a221,
  yellow-40: #713501,
  green-89: #cbe996,
  green-68: #6dac0d,
  green-46: #196a06,
  teal-88: #aae4dd,
  teal-69: #05b59d,
  teal-48: #026e60,
  sky-85: #a8d6f4,
  sky-69: #34a3ea,
  sky-37: #03436c,
  blue-82: #b1c2f5,
  blue-56: #3b65eb,
  blue-29: #0b2167,
  violet-82: #cfb8f5,
  violet-54: #743ff2,
  violet-27: #250969,
  pink-87: #f5c1df,
  pink-70: #f162af,
  pink-33: #64093a,
  // Greys for the cream ground, in the light yellow's hue. As they darken they warm towards the yellow's mid and
  // gain a little chroma, as the ground's bleed does, so they stay warm rather than dull
  sand-97: #f7f5f0,
  sand-94: #edebe5,
  sand-90: #e0ded7,
  sand-84: #cecac3,
  sand-76: #b5b1a7,
  sand-66: #979187,
  sand-56: #7b7468,
  sand-46: #5f5749,
  sand-36: #453c2d,
  sand-26: #2c2213,
  // Neutral greys for white, at sand's steps. On the layer each is for, 56 and darker pass 4.5:1 for text, and 66
  // and darker 3:1 for a control's edge
  grey-97: .whitesmoke,
  grey-94: #ebebeb,
  grey-90: #dedede,
  grey-84: #cacaca,
  grey-76: #b1b1b1,
  grey-66: #929292,
  grey-56: #747474,
  grey-46: #585858,
  grey-36: #3d3d3d,
  grey-26: #242424,
  // The roles, each light-dark(light, dark). The dark mode inverts the light one: the ground takes ink's
  // pine, and ink takes the ground's cream
  ink: pine-26,
  muted: pine-50,
  danger: red-50,
  // Marks on ink or the accent, such as a button's text or a checkbox's tick
  paper: white,
  // What a page leads with, such as a solid button. It stays rust in the dark, where paper turns dark
  accent: rust-60,
  // The light accent, a fill behind ink to mark something out. In the dark it's a lime tint over what it sits on
  highlight: lime-91,
  // The layers, from the page up. In the light, panel, raised and overlay are all white, and shadows part them.
  // In the dark, each is lighter than the one below, and the panel is the light mode's ink
  ground: cream-99,
  // An area on the page, such as a tool's side panel
  panel: white,
  // A control's fill, such as a button's, a field's or a checkbox's
  raised: white,
  // What raised turns on hover
  surface: blush-95,
  // Popovers, menus, dialogs, sheets and floating toolbars
  overlay: white,
  // Ink as a surface, such as a toast or a tooltip, with paper text
  inverse: ink,
  // A switch's handle and a slider's thumb, which stay lighter than their track
  knob: white,
  // Tints and lines mix from bleed at 4, 8, 12, 16, 24 or 32%, such as bg-bleed/8 for a line. See-through
  // ink would grey the cream ground, so on the ground it's ink in the ground's hue. Every layer sets its own,
  // as in bg-overlay [--bleed:var(--overlay-bleed)], so a tint suits what it sits on
  ground-bleed: umber-30,
  panel-bleed: pine-26,
  raised-bleed: pine-26,
  overlay-bleed: pine-26,
  inverse-bleed: white,
  bleed: ground-bleed,
  // Behind a sheet
  scrim: opacity(pine-26, 32%),
  // Shadows have their own colours, so they stay dark in the dark. The edge is the ground's line colour, and the
  // drops warm the cream in the light, as the tints do
  edge: opacity(bleed, 8%),
  drop-raised: opacity(bleed, 8%),
  drop-floating: opacity(bleed, 16%),
  drop-overlay: opacity(bleed, 24%)
}

// A tint is a layer’s bleed at 4, 8, 12, 16, 24 or 32%, named for the layer it sits on, such as overlay-8 for a
// hovered menu item
@variants(dark.dark-tints)
export tints = tokens {
  ground-4: opacity(colors.ground-bleed, 4%),
  ground-8: opacity(colors.ground-bleed, 8%),
  ground-12: opacity(colors.ground-bleed, 12%),
  ground-16: opacity(colors.ground-bleed, 16%),
  ground-24: opacity(colors.ground-bleed, 24%),
  ground-32: opacity(colors.ground-bleed, 32%),
  panel-4: opacity(colors.panel-bleed, 4%),
  panel-8: opacity(colors.panel-bleed, 8%),
  panel-12: opacity(colors.panel-bleed, 12%),
  panel-16: opacity(colors.panel-bleed, 16%),
  panel-24: opacity(colors.panel-bleed, 24%),
  panel-32: opacity(colors.panel-bleed, 32%),
  raised-4: opacity(colors.raised-bleed, 4%),
  raised-8: opacity(colors.raised-bleed, 8%),
  raised-12: opacity(colors.raised-bleed, 12%),
  raised-16: opacity(colors.raised-bleed, 16%),
  raised-24: opacity(colors.raised-bleed, 24%),
  raised-32: opacity(colors.raised-bleed, 32%),
  overlay-4: opacity(colors.overlay-bleed, 4%),
  overlay-8: opacity(colors.overlay-bleed, 8%),
  overlay-12: opacity(colors.overlay-bleed, 12%),
  overlay-16: opacity(colors.overlay-bleed, 16%),
  overlay-24: opacity(colors.overlay-bleed, 24%),
  overlay-32: opacity(colors.overlay-bleed, 32%),
  inverse-4: opacity(colors.inverse-bleed, 4%),
  inverse-8: opacity(colors.inverse-bleed, 8%),
  inverse-12: opacity(colors.inverse-bleed, 12%),
  inverse-16: opacity(colors.inverse-bleed, 16%),
  inverse-24: opacity(colors.inverse-bleed, 24%),
  inverse-32: opacity(colors.inverse-bleed, 32%)
}
