import "./typography-coarse.elyx" as coarse

// Parchment’s type: the sizes the text components use, in points, and their leadings, as multiples of the size.
// fonts.elyx names the families. typography-coarse.elyx holds the sizes in the pointer=coarse context.
// Written from packages/ui/styles/theme.css by pnpm elyx:tokens, so edit the CSS rather than this file.
file {}

@variants(coarse.coarse-typography)
export typography = tokens {
  text-body: 14,
  // 20px in the CSS, and a multiple of text-body here, as Elyx takes line height
  text-body-line-height: 1.43,
  // Text in buttons, fields, labels, options and tabs, on a 20px line at either size. A control's padding adds to
  // the line, so 6px above and below makes it 32px tall, and an icon in a control sits on the line as text does
  text-control: 13,
  // 20px in the CSS, and a multiple of text-control here, as Elyx takes line height
  text-control-line-height: 1.54,
  text-label: 12,
  // A whole 16px, so what follows a label lands on whole pixels, and text in a button below it centres the same in every row
  // 16px in the CSS, and a multiple of text-label here, as Elyx takes line height
  text-label-line-height: 1.33,
  // Bold, as the brand's own lettering is, and drawn in a touch, as bold at this size sits loose
  text-title: 20,
  // 22px in the CSS, and a multiple of text-title here, as Elyx takes line height
  text-title-line-height: 1.1,
  // Prose's headings, each a step up, on lines of 4px steps, so a heading of any length ends on Loupe's grid as
  // prose's text does
  text-reading-subheading: 16,
  // 24px in the CSS, and a multiple of text-reading-subheading here, as Elyx takes line height
  text-reading-subheading-line-height: 1.5,
  text-reading-heading: 20,
  // 28px in the CSS, and a multiple of text-reading-heading here, as Elyx takes line height
  text-reading-heading-line-height: 1.4,
  text-reading-display: 24,
  // 32px in the CSS, and a multiple of text-reading-display here, as Elyx takes line height
  text-reading-display-line-height: 1.33
}
