{
  "name": "loupe",
  "private": true,
  "description": "Parchment’s shared design library, used by mcknny, iamsteve and parchment",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "icons": "pnpm --filter @parchment/icons build",
    "icons:watch": "pnpm --filter @parchment/icons watch",
    "logos": "pnpm --filter @parchment/logos build",
    "logos:watch": "pnpm --filter @parchment/logos watch",
    "release": "node scripts/release.mjs"
  }
}
