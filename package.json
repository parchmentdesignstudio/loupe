{
  "name": "@parchment/ui",
  "version": "0.11.0",
  "description": "Accessible React components built on React Aria, styled with Tailwind through tailwind-variants",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "lib",
    "styles",
    "tokens.css"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./shiki": {
      "types": "./lib/shiki.d.ts",
      "default": "./lib/shiki.js"
    },
    "./docs": {
      "types": "./lib/docs.d.ts",
      "default": "./lib/docs.js"
    },
    "./tokens.css": "./tokens.css",
    "./styles/*": "./styles/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "vite --port 5199 --strictPort",
    "eval": "node preview/genui/evals/run.mjs",
    "elyx:css": "node elyx/build-css.ts",
    "site": "vite build && wrangler deploy"
  },
  "peerDependencies": {
    "@shikijs/transformers": ">=4",
    "react": ">=19",
    "react-dom": ">=19",
    "shiki": ">=4"
  },
  "peerDependenciesMeta": {
    "@shikijs/transformers": {
      "optional": true
    },
    "shiki": {
      "optional": true
    }
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "react-aria": "3.53.1",
    "react-aria-components": "^1.22.1",
    "tailwind-variants": "^4.0.0"
  }
}
