{
  "name": "loupe",
  "private": true,
  "description": "Parchment’s shared design library, used by mcknny, iamsteve and parchment",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "icons": "pnpm --filter @parchment/icons build",
    "icons:watch": "pnpm --filter @parchment/icons watch",
    "ui": "pnpm --filter @parchment/ui dev",
    "release": "node scripts/release.mjs",
    "lint": "oxlint",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "oxlint": "^1.90.0"
  }
}
