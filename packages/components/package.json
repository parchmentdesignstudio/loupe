{
  "name": "@parchment/components",
  "version": "0.1.0",
  "description": "Accessible React components built on React Aria and styled with Tailwind",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "lib",
    "theme.css"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./theme.css": "./theme.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "vite --config vite.config.ts",
    "preview:build": "vite build --config vite.config.ts"
  },
  "peerDependencies": {
    "@parchment/icons": ">=0.6.0",
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=4"
  },
  "dependencies": {
    "react-aria-components": "^1.22.1",
    "tailwind-variants": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "@parchment/icons": "workspace:*"
  }
}
