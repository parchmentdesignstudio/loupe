{
  "name": "@parchment/icons",
  "version": "0.6.0",
  "description": "Line and solid icons at 16 and 24px, as SVG files, sprites, and Astro and React components",
  "type": "module",
  "sideEffects": false,
  "files": [
    "lib",
    "svg",
    "sprite",
    "data.js",
    "data.d.ts",
    "icons.json",
    "parts.json"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./astro": "./lib/astro/Icon.astro",
    "./react": {
      "types": "./lib/react/index.d.ts",
      "default": "./lib/react/index.js"
    },
    "./icons.json": "./icons.json",
    "./parts.json": "./parts.json",
    "./svg/*": "./svg/*",
    "./sprite/*": "./sprite/*"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch"
  },
  "peerDependencies": {
    "astro": ">=4",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "svgo": "^4.0.0"
  }
}
