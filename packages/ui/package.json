{
  "name": "@parchment/ui",
  "version": "0.11.0",
  "description": "Accessible React components built on React Aria, styled with Tailwind through tailwind-variants",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "lib",
    "styles",
    "tokens.css"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./shiki": {
      "types": "./lib/shiki.d.ts",
      "default": "./lib/shiki.js"
    },
    "./docs": {
      "types": "./lib/docs.d.ts",
      "default": "./lib/docs.js"
    },
    "./tokens.css": "./tokens.css",
    "./styles/*": "./styles/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "vite --port 5199 --strictPort",
    "eval": "node preview/genui/evals/run.mjs",
    "elyx:css": "node elyx/build-css.ts",
    "site": "vite build && wrangler deploy"
  },
  "peerDependencies": {
    "@shikijs/transformers": ">=4",
    "react": ">=19",
    "react-dom": ">=19",
    "shiki": ">=4"
  },
  "peerDependenciesMeta": {
    "@shikijs/transformers": {
      "optional": true
    },
    "shiki": {
      "optional": true
    }
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "react-aria": "3.53.1",
    "react-aria-components": "^1.22.1",
    "tailwind-variants": "^4.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@parchment/icons": "workspace:*",
    "@shikijs/transformers": "^4.6.0",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "marked": "^18.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.166.0"
  }
}
